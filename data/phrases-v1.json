      "label": "a / à",
      "question": "Je mets « avait » à la place : ça sonne juste ?",
      "witness": "avait",
      "confirms": [
        "a"
      ],
      "otherwise": "à",
      "sources": [
        "S1",
        "S7"
      ],
      "theme": "a / à",
      "ordre": 5,
      "lecon": {
        "situer": [
          "« a » et « à » se prononcent pareil.",
          "« a », c'est le verbe avoir : il a, elle a. « à », c'est un petit mot qui relie : à la maison, à Paul."
        ],
        "observer": [
          "On remplace par « avait » et on prononce la phrase.",
          "Si elle sonne juste, c'est le verbe avoir : j'écris « a ». Sinon, j'écris « à »."
        ],
        "reflechir": "Voici deux phrases. On essaie « avait » dans chacune."
      }
    },
    "on_ont": {
      "label": "on / ont",
      "question": "Je mets « il » à la place : ça sonne juste ?",
      "witness": "il",
      "confirms": [
        "on"
      ],
      "otherwise": "ont",
      "sources": [
        "S1",
        "S7"
      ],
      "theme": "on / ont",
      "ordre": 6,
      "lecon": {
        "situer": [
          "« on » et « ont » se prononcent pareil.",
          "« on » veut dire quelqu'un, comme il ou elle, ou parfois nous : on est fatigués (= nous sommes fatigués). « ont », c'est le verbe avoir pour plusieurs personnes : ils ont, elles ont."
        ],
        "observer": [
          "On remplace par « il » et on prononce la phrase (on est fatigués : il est fatigué, ça sonne juste ; ils ont chaud : ils il chaud, non).",
          "Si elle sonne juste, c'est « on » : j'écris « on ». Sinon, c'est le verbe avoir : j'écris « ont »."
        ],
        "reflechir": "Voici deux phrases. On essaie « il » dans chacune."
      }
    },
