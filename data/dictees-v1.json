  "regles": {
    "cest_sest": {
      "theme": "c'est / s'est",
      "question": "Je mets « cela est » à la place : ça sonne juste ?",
      "witness": "cela est",
      "confirms": [
        "c'est"
      ],
      "otherwise": "s'est",
      "sources": [
        "S2",
        "S7"
      ]
    },
    "la_la": {
      "theme": "la / là",
      "question": "Je mets « ici » à la place : ça sonne juste ?",
      "witness": "ici",
      "confirms": [
        "là"
      ],
      "otherwise": "la",
      "sources": [
        "S7",
        "S10"
      ]
    }
  },
  "astuces": {
    "sv": {
      "theme": "Le verbe et celui qui fait l'action",
      "lignes": [
        "Je trouve qui fait l'action avec « c'est … qui » (ou « ce sont … qui »).",
        "Je remplace par « il / elle » ou « ils / elles » : c'est le seul moyen de distinguer aime et aiment."
      ],
      "sources": [
        "S4"
      ]
    },
    "pl": {
      "theme": "Le pluriel des noms",
      "lignes": [
        "Cas général : on ajoute -s."
      ],
      "sources": [
        "S12"
      ]
    },
    "adj": {
      "theme": "L'adjectif et le nom",
      "lignes": [
        "Le petit mot devant le nom et l'adjectif prennent le même nombre et le même genre que le nom.",
        "Pour vérifier, je mets le groupe au pluriel ou au féminin."
      ],
      "sources": [
        "S12"
      ]
    },
    "imp": {
      "theme": "L'imparfait",
      "lignes": [
        "Avec je ou tu : -ais. Avec il, elle ou on : -ait. Avec ils ou elles : -aient."
      ],
      "sources": [
        "S14"
      ]
    },
    "futur": {
      "theme": "Le futur",
      "lignes": null,
      "sources": []
    },
    "pe": {
      "theme": "Le participe avec être",
      "lignes": [
        "Avec être, le participe s'accorde avec celui qui fait l'action : elle est partie, ils sont arrivés.",
        "Pour voir la lettre cachée, je mets au féminin."
      ],
      "sources": [
        "S6",
        "S19"
      ]
    },
    "cs": {
      "theme": "ces / ses",
      "lignes": [
        "ses : je peux mettre mes ou tes (ses cerises, mes cerises).",
        "ces : je peux mettre ce ou cette au singulier (ces fruits, ce fruit)."
      ],
      "sources": [
        "S2",
        "S7"
      ]
    },
    "plx": {
      "theme": "Le pluriel en -x",
      "lignes": [
        "Les noms en -ou prennent -s, sauf 7 : chou, bijou, joujou, genou, caillou, hibou, pou (ils prennent -x).",
        "Les noms en -eau prennent -x : un chameau, des chameaux."
      ],
      "sources": [
        "S5",
        "S26"
      ]
    },
    "ez": {
      "theme": "-ez : seulement avec vous",
      "lignes": [
        "On écrit -ez seulement quand le mot est avec « vous » : vous chantez.",
        "Piège : « je pourrais vous aider » : le verbe aider est à l'infinitif, donc -er."
      ],
      "sources": [
        "S3",
        "S14",
        "S35"
      ]
    },
    "att": {
      "theme": "L'adjectif après être, sembler, paraître",
      "lignes": null,
      "sources": []
    },
    "ps": {
      "theme": "Le passé simple",
      "lignes": null,
      "sources": []
    },
    "cese": {
      "theme": "ce / se",
      "lignes": null,
      "sources": []
    },
    "conn": {
      "theme": "Les mots qui relient les idées",
      "lignes": null,
      "sources": []
    }
  },
